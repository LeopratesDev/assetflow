# Copy this file to .env and fill in your values
# NEVER commit .env to git

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/it_asset_manager
SECRET_KEY=change-me-to-a-random-256-bit-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# JSON array para múltiplas origens: ["http://localhost:5173","https://meusite.com"]
CORS_ORIGINS=["http://localhost:5173"]
ENVIRONMENT=development
