{
  "buildCommand": "npm --prefix web install && npm --prefix web run build",
  "outputDirectory": "web/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://it-asset-manager-il7e.onrender.com/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "env": {
    "VITE_API_URL": ""
  }
}
