{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://it-asset-manager-api.onrender.com/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "env": {
    "VITE_API_URL": ""
  }
}
